<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/menu_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/navy" android:scrollbars="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp">
    <ImageView android:id="@+id/imgLogo" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:layout_marginTop="14dp" android:src="@drawable/logo_nutrimaster" android:contentDescription="@string/app_name"/>
    <TextView android:id="@+id/txtMenuTitulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:text="@string/menu_titulo" android:textColor="@color/white" android:textSize="13sp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnPerfil" style="@style/NM.MenuButton" android:text="@string/opcion_perfil"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnFotos" style="@style/NM.MenuButton" android:text="@string/opcion_fotos"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnVideo" style="@style/NM.MenuButton" android:text="@string/opcion_video"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnWeb" style="@style/NM.MenuButton" android:text="@string/opcion_web"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnBotones" style="@style/NM.MenuButton" android:text="@string/opcion_botones"/>
    <TextView style="@style/NM.Caption" android:text="@string/offline" android:textSize="9sp" android:textColor="@color/nav_text" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="center"/>
  </LinearLayout>
</ScrollView>
