<?xml version='1.0' encoding='utf-8'?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/app_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/navy">
  <LinearLayout android:id="@+id/inset_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="68dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
      <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_leaf" android:importantForAccessibility="no"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/white"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_descripcion" android:textSize="11sp" android:textColor="@color/nav_text"/>
      </LinearLayout>
      <TextView android:id="@+id/about_button" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="?" android:textSize="20sp" android:textColor="@color/accent" android:contentDescription="@string/about" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
    <!-- RF-01 / RF-08: two simultaneous panels, even on a narrow phone. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false" android:background="@color/surface">
      <FrameLayout android:id="@+id/contenedorMenu" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:background="@color/navy"/>
      <FrameLayout android:id="@+id/contenedorContenido" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="7"/>
    </LinearLayout>
  </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
