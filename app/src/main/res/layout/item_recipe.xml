<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/recipe_item" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="3dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
  <ImageView android:id="@+id/thumbnail" android:layout_width="match_parent" android:layout_height="76dp" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
  <TextView android:id="@+id/thumbnail_title" style="@style/NM.Caption" android:textColor="@color/ink" android:textStyle="bold" android:maxLines="2" android:minLines="2" android:ellipsize="end" android:layout_marginTop="5dp"/>
  <TextView android:id="@+id/thumbnail_state" style="@style/NM.Caption" android:textSize="11sp" android:textColor="@color/blue" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
